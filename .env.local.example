# Settings for `pnpm dev` and the web dev server. Copy: cp .env.local.example .env.local
# Only local development reads .env.local. Docker Compose reads .env, so these
# values don't change the compose app.
#
# The ports avoid the common defaults (3000, 5173, 8080) that other projects use.
# Change them here if something else already holds them.

# The `db-test` container from `pnpm db:test:up`. Its data lives in memory and is lost when it stops.
DATABASE_URL=postgres://clankerboard:clankerboard@localhost:55432/postgres

# API server.
PORT=4310

# Vite dev server, the address you open in the browser.
WEB_PORT=4311

# Must be the address you open in the browser (the Vite dev server), or Better Auth
# rejects sign-in with INVALID_ORIGIN and Invite links point at the wrong place.
BASE_URL=http://localhost:4311

# Optional. The defaults are in docker-compose.yml.
# LOG_LEVEL=debug
# OPEN_SIGNUP=true
# AUTH_SECRET=
# SMTP_HOST=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
